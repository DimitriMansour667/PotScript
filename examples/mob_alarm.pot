# Mob alarm: watches for hostile mobs, shows the nearest one on a sign,
# beeps and fires a redstone pulse (e.g. into a lamp or dispenser).
#
# Setup: place a sign on one side of the pot, wire the "up" side to a lamp.

let hostiles = ["minecraft:zombie", "minecraft:skeleton", "minecraft:creeper",
                "minecraft:spider", "minecraft:witch", "minecraft:enderman"]

let sign = getBlock("north")
let lamp = getBlock("up")
sign.write(["mob alarm", "all clear"], "lime")

while true {
    let found = nil
    let near = entities(12)
    let i = 0
    while i < len(near) {
        # each entry is [type, name, distance], nearest first
        if find(hostiles, near[i][0]) >= 0 {
            found = near[i]
            break
        }
        i = i + 1
    }

    if found != nil {
        sign.write(["! ALARM !", found[1], str(found[2]) + " blocks"], "red")
        lamp.rs_pulse(15, 10)
        beep(20)
    } else {
        sign.write(["mob alarm", "all clear"], "lime")
    }
    sleep(20)
}
